# 复制为 .env 并填写后，Melo 的 AI 拆解 / 今日规划将使用真实大模型
# （未配置时自动回退到本地规则引擎，不影响任何功能）
#
# 支持任意 OpenAI 兼容接口，国内可用 DeepSeek / Kimi / 智谱等：
#   DeepSeek :  https://api.deepseek.com        model: deepseek-chat
#   Kimi     :  https://api.moonshot.cn/v1      model: moonshot-v1-8k
#   OpenAI   :  https://api.openai.com/v1       model: gpt-4o-mini

LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 生产环境必须设置（JWT 签名密钥，生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=